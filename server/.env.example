# ============================================================
# TÜBİTAK 1831 Sunucu Yapılandırması
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
# ============================================================

# Sunucu portu
PORT=4000

# --- Üretim Motoru: ChatGPT web (Playwright) ---
# Üretim, ChatGPT web arayüzü otomatikleştirilerek yapılır (Claude API kullanılmaz).
# Bir kez giriş: "npm run chatgpt:login" (server klasöründen) veya arayüzdeki "ChatGPT Giriş".
# Opsiyonel ayarlar:
# CHATGPT_HEADLESS=false        # true → görünmez tarayıcı (genelde Cloudflare engeller, önerilmez)
# CHATGPT_CHANNEL=chrome        # sistemde kurulu Google Chrome'u kullan (boş → Playwright Chromium)
# CHATGPT_RESPONSE_TIMEOUT=300000

# --- Obsidian bilgi grafiği ---
# Vault klasörünün yolu (varsayılan: proje kökündeki "knowledge" klasörü)
KNOWLEDGE_VAULT_PATH=../knowledge

# --- Google (Docs + Drive + Gmail) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client (Desktop app)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx
# "npm run google:auth" komutuyla bir kez alınır:
GOOGLE_REFRESH_TOKEN=

# Oluşturulan dokümanların kopyalanacağı şablon Google Doc ID'si (opsiyonel).
# Boş bırakılırsa boş bir doküman oluşturulur.
TEMPLATE_DOC_ID=

# Bildirim ve doküman paylaşımı yapılacak e-postalar (virgülle ayrılmış)
RECIPIENTS=anis.nakib@sunandsun.com.tr,sude.solakoglu@sundanismanlik.net,gokce.kurnaz@sundanismanlik.net
